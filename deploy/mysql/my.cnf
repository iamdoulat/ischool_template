# ==============================================================================
# iSchool MySQL Production Configuration
# Location: /etc/mysql/conf.d/ischool.cnf or /etc/mysql/mysql.conf.d/mysqld.cnf
# ==============================================================================

[mysqld]
# Connection & Threading
max_connections                = 300
max_connect_errors             = 10000
thread_cache_size              = 32
table_open_cache               = 4000
table_definition_cache         = 2000
open_files_limit               = 65535

# InnoDB Buffer & I/O Settings (Set innodb_buffer_pool_size to ~40-50% of Server RAM)
# 4GB RAM VPS  -> 1.5G - 2G
# 8GB RAM VPS  -> 3G - 4G (Default below)
# 16GB RAM VPS -> 8G - 10G
innodb_buffer_pool_size        = 3G
innodb_buffer_pool_instances  = 4
innodb_log_file_size           = 512M
innodb_log_buffer_size         = 64M
innodb_flush_log_at_trx_commit = 2              # High write performance
innodb_flush_method            = O_DIRECT
innodb_file_per_table          = 1
innodb_io_capacity             = 2000           # For NVMe SSDs
innodb_io_capacity_max         = 4000

# Cache & Temp Tables
tmp_table_size                 = 64M
max_heap_table_size            = 64M
sort_buffer_size               = 4M
join_buffer_size               = 4M
read_buffer_size               = 2M
read_rnd_buffer_size           = 4M

# Character Set & Collation
character-set-server           = utf8mb4
collation-server               = utf8mb4_unicode_ci

# Binary Logging & Durability
sync_binlog                    = 0
expire_logs_days               = 7
max_binlog_size                = 256M

# Slow Query Log (For troubleshooting slow searches/reports)
slow_query_log                 = 1
slow_query_log_file            = /var/log/mysql/mysql-slow.log
long_query_time                = 1
